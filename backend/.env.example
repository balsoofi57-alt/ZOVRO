NODE_ENV=production
PORT=8787
ZOVRO_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ZOVRO_OPS_TOKEN=replace-with-a-long-random-ops-token
ZOVRO_ALLOWED_ORIGINS=https://zovro.net,https://www.zovro.net,https://zovro-web.onrender.com,capacitor://localhost,http://localhost
ZOVRO_APP_VERSION=1.0.0

# Stripe Connect marketplace payments (store real values only in Render)
# pk_... is public and may be returned to the mobile app. Never expose sk_... or whsec_... to clients.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ZOVRO_PLATFORM_FEE_BPS=0
ZOVRO_PAYMENT_CURRENCY=usd
ZOVRO_APPLE_PAY_ENABLED=false
ZOVRO_GOOGLE_PAY_ENABLED=false
ZOVRO_GOOGLE_PAY_TEST_ENV=false

# OneSignal push notifications (store real REST key only in Render)
ONESIGNAL_APP_ID=7992b022-6c11-4a66-bad4-8cbd114266d0
ONESIGNAL_REST_API_KEY=

# Durable PostgreSQL cutover (store only in Render; use a permanent plan for production)
DATABASE_URL=
PGSSLMODE=require
