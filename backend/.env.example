NODE_ENV=production
PORT=8787
ZOVRO_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ZOVRO_OPS_TOKEN=replace-with-a-long-random-ops-token
ZOVRO_ALLOWED_ORIGINS=https://zovro.net,https://www.zovro.net,https://zovro-web.onrender.com,capacitor://localhost,http://localhost
ZOVRO_APP_VERSION=1.0.0

# Field-level encryption for sensitive profile data. Generate a separate 32+ byte secret and store it only in Render.
ZOVRO_PROFILE_ENCRYPTION_KEY=

# Stripe Connect marketplace payments (store real values only in Render)
# pk_... is public and may be returned to the mobile app. Never expose sk_... or whsec_... to clients.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ZOVRO_PLATFORM_FEE_BPS=1000
ZOVRO_PAYMENT_CURRENCY=usd
ZOVRO_APPLE_PAY_ENABLED=false
ZOVRO_APPLE_PAY_MERCHANT_ID=
ZOVRO_GOOGLE_PAY_ENABLED=false
ZOVRO_GOOGLE_PAY_TEST_ENV=false

# OneSignal push notifications (store real REST key only in Render)
ONESIGNAL_APP_ID=7992b022-6c11-4a66-bad4-8cbd114266d0
ONESIGNAL_REST_API_KEY=

# Durable PostgreSQL cutover (store only in Render; use a permanent plan for production)
DATABASE_URL=
PGSSLMODE=require
ZOVRO_DB_MIRROR_MODE=off

# SMS notification-only delivery via Twilio. Keep disabled until A2P/consent/STOP handling is verified.
ZOVRO_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Prefer a Messaging Service SID for A2P campaigns; otherwise configure a Twilio From number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
ZOVRO_SMS_STATUS_CALLBACK_URL=
# Exact public webhook URL used for Twilio signature validation, e.g. https://api.example.com/api/sms/twilio/inbound
ZOVRO_SMS_INBOUND_URL=
ZOVRO_SMS_MAX_ATTEMPTS=3
ZOVRO_SMS_TIMEOUT_MS=7000


# Password recovery via Twilio Verify.
# Keep disabled until all three Twilio values below are configured in Render.
ZOVRO_PASSWORD_RECOVERY_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio Verify Service SID begins with VA...
TWILIO_RECOVERY_VERIFY_SERVICE_SID=
